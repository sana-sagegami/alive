{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alive",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-30",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "HEARTRATE_KV",
			"id": "02969d36e27646cfbc152d14bede35e9"
		}
	]
}
